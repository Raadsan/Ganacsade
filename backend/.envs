# Application
NODE_ENV=development
PORT=5000                                           
API_VERSION=v1
APP_NAME=GANACSADE

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ganacsade_db
DB_USER=postgres
DB_PASSWORD=1234
DB_SSL=false

# JWT Authentication
JWT_SECRET=ganacsade_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ganacsade_refresh_secret_key_change_in_production_2024
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=ganacsade_session_secret_change_this

# Misc
TIMEZONE=Africa/Mogadishu
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=USD
TAX_RATE=5
SHIPPING_FLAT_RATE=5.00

# Frontend URLs
ADMIN_DASHBOARD_URL=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:3001


# WaafiPay (Direct API)
